# PLANTILLA PÚBLICA. Copiar como backend/.env y completar solo en local.
# Las variables se cargan al arrancar Uvicorn / Docker, no al servir la web.
# No se requiere lista de cuadros, token global ni registro previo.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_ORIGIN_REGEX='^http://cuadro-sonoro-[a-z0-9-]+\.local$'
# Secreto de Apify: solo backend. En Render, crear como Environment Secret.
APIFY_TOKEN=
# Actors configurados en la consola Apify (planes/cargos cambian; revisar antes de usar).
APIFY_SEARCH_ACTOR=streamers/youtube-scraper
APIFY_DOWNLOAD_ACTOR=lurkapi/youtube-to-mp3-audio-downloader
APIFY_SEARCH_TIMEOUT_SECONDS=90
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_ACTOR_TIMEOUT_SECONDS=240
APIFY_SEARCH_CACHE_SECONDS=300
APIFY_SEARCH_MIN_INTERVAL_SECONDS=2
APIFY_IMPORT_MIN_INTERVAL_SECONDS=10
APIFY_MAX_ACTIVE_IMPORTS=1
# Configuración específica del entorno: no concede acceso por sí misma.
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
# Credencial privada A: ruta al fichero, fuera de Git.
# Docker: /run/secrets/firebase.json. Nativo: ruta absoluta en tu equipo.
GOOGLE_APPLICATION_CREDENTIALS=
# Credencial privada B: JSON completo como secreto en Render; dejar vacío si se usa A.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Persistencia temporal de desarrollo cuando no se configura Firebase Database.
STATE_DB=/tmp/sonoro.sqlite3
