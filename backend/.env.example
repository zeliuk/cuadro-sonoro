# PLANTILLA PÚBLICA. Copiar como backend/.env y completar solo en local.
# Las variables se cargan al arrancar Uvicorn / Docker, no al servir la web.
# Token aleatorio del único cuadro de desarrollo; setup_local.py lo genera.
# Producción usa un token distinto por cuadro y no configura un token global aquí.
LOCAL_FRAME_TOKEN=
# Producción: SHA-256 hex de los tokens provisionados, separados por comas.
FRAME_TOKEN_HASHES=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Configuración específica del entorno: no concede acceso por sí misma.
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
# Clave pública del proyecto Firebase; la usa Auth REST del cliente de dispositivo.
FIREBASE_WEB_API_KEY=
# Credencial privada A: ruta al fichero, fuera de Git.
# Docker: /run/secrets/firebase.json. Nativo: ruta absoluta en tu equipo.
GOOGLE_APPLICATION_CREDENTIALS=
# Credencial privada B: JSON completo como secreto en Render; dejar vacío si se usa A.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Persistencia temporal de desarrollo cuando no se configura Firebase Database.
STATE_DB=/tmp/sonoro.sqlite3
