        }
      }
    },
    "/media/{slot}": {
      "get": {
        "summary": "Media",
        "operationId": "media_media__slot__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "slot",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Slot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido o no provisionado."
          },
          "404": {
            "description": "Hueco vacío en este cuadro."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Import": {
        "properties": {
          "slot": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Slot"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "artist": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Artist"
          }
        },
        "type": "object",
        "required": [
          "slot",
          "source_id",
          "title",
          "artist"
        ],
        "title": "Import"
      },
      "Search": {
        "properties": {
          "artist": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Artist"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "artist",
          "title"
        ],
        "title": "Search"
      },
      "Station": {
        "properties": {
          "slot": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Slot"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "url": {
            "type": "string",
            "maxLength": 1000,
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "slot",
          "title",
          "url"
        ],
        "title": "Station"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token aleatorio provisionado para el cuadro, mínimo 32 caracteres. No usar una credencial administrativa de Firebase.",
        "scheme": "bearer"
      }
    }
  }
}
