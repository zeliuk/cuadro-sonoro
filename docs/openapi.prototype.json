{
  "openapi": "3.1.0",
  "info": {
    "title": "Sonoro API",
    "description": "API experimental de Sonoro. Las operaciones de cuadro usan un token Bearer y separan datos mediante su huella SHA-256. No proporciona acceso autónomo a medios para el ESP32.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "summary": "Search",
        "operationId": "search_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Search"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido o no provisionado."
          },
          "502": {
            "description": "Falló la búsqueda en la fuente."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/imports": {
      "post": {
        "summary": "Create Import",
        "operationId": "create_import_imports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Import"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido o no provisionado."
          },
          "409": {
            "description": "El cuadro ya tiene una importación activa."
          },
          "503": {
            "description": "Firebase Storage no está configurado."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/state": {
      "get": {
        "summary": "State",
        "operationId": "state_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
